# Copia este archivo como ".env" (cp .env.example .env) y rellena lo que uses.

# Motor de IA: "ollama" (gratis, en tu ordenador) o "anthropic" (Claude, de pago)
PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b

# Solo si PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5-5

# Solo si quieres enviar el CV por correo desde la app.
# Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación".
# SMTP_USER=tucorreo@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicación
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Avanzado
# PORT=3000
# OLLAMA_URL=http://127.0.0.1:11434
# DATA_FILE=./data.json
# FREEHIRE_API_URL=https://freehire.me
